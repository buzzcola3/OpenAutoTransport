genrule(
    name = "wire_capnp_gen",
    srcs = ["wire.capnp"],
    outs = [
        "wire.capnp.h",
        "wire.capnp.c++",
    ],
    tools = [
        "@capnp-cpp//src/capnp:capnp_tool",
        "@capnp-cpp//src/capnp:capnpc-c++",
    ],
    cmd = """
      mkdir -p $(@D)/transport && \
      $(location @capnp-cpp//src/capnp:capnp_tool) compile \
        --src-prefix=. \
        -o$(location @capnp-cpp//src/capnp:capnpc-c++):$(@D)/transport \
        $(location wire.capnp) && \
      mv $(@D)/transport/wire.capnp.h $(@D)/transport/wire.capnp.c++ $(@D)/
    """,
    visibility = ["//visibility:public"],
)

cc_library(
    name = "wire_capnp",
    srcs = ["wire.capnp.c++"],
    hdrs = ["wire.capnp.h"],
    copts = ["-xc++"],
    deps = [
        "@capnp-cpp//src/capnp:capnp",
        "@capnp-cpp//src/kj:kj",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "open_auto_transport",
    srcs = ["transport.cpp"],
    hdrs = ["transport.hpp", "wire.hpp"],
    copts = ["-fPIC"],
    deps = [
        ":wire_capnp",
        "//shared_memory:duplex_shm_transport",
        "@boost.asio",
        "@capnp-cpp//src/capnp:capnp",
        "@capnp-cpp//src/kj:kj",
    ],
    visibility = ["//visibility:public"],
)

cc_binary(
    name = "open_auto_transport_demo",
    srcs = ["transport_demo.cpp"],
    deps = [
        ":open_auto_transport",
        ":wire_capnp",
        "//shared_memory:duplex_shm_transport",
        "@capnp-cpp//src/capnp:capnp",
        "@capnp-cpp//src/kj:kj",
        "@boost.asio",
    ],
)