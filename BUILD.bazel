genrule(
    name = "wire_capnp_gen",
    srcs = ["wire.capnp"],
    outs = [
        "wire.capnp.h",
        "wire.capnp.c++",
    ],
    tools = [
        "@capnp-cpp//src/capnp:capnp_tool",
        "@capnp-cpp//src/capnp:capnpc-c++",
    ],
    cmd = """
      set -euo pipefail
      SRC="$(location :wire.capnp)"
      SRCDIR="$$(dirname "$$SRC")"
      OUTDIR="$(@D)"
      CAPNP_BIN="$(execpath @capnp-cpp//src/capnp:capnp_tool)"
      CAPNPC_PLUGIN="$(execpath @capnp-cpp//src/capnp:capnpc-c++)"

      mkdir -p "$$OUTDIR"
      "$$CAPNP_BIN" compile \
        --src-prefix="$$SRCDIR" \
        -o"$$CAPNPC_PLUGIN":"$$OUTDIR" \
        "$$SRC"

      test -f "$$OUTDIR/wire.capnp.h"
      test -f "$$OUTDIR/wire.capnp.c++"
    """,
    visibility = ["//visibility:public"],
)

# Public access to the generated files themselves (if a consumer needs raw files)
filegroup(
    name = "wire_capnp_generated",
    srcs = [
        "wire.capnp.h",
        "wire.capnp.c++",
    ],
    visibility = ["//visibility:public"],
)

# Library wrapping the generated Cap'n Proto sources
cc_library(
    name = "wire_capnp",
    srcs = ["wire.capnp.c++"],
    hdrs = ["wire.capnp.h"],
    copts = ["-xc++"],
    deps = [
        "@capnp-cpp//src/capnp:capnp",
        "@capnp-cpp//src/kj:kj",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "open_auto_transport",
    srcs = [
        "transport.cpp",
        "//shared_memory:duplex_shm_transport.cpp",
    ],
    hdrs = [
        "transport.hpp",
        "wire.hpp",
        "//shared_memory:duplex_shm_transport.hpp",
    ],
    copts = [
        "-fPIC",
        "-std=c++17",
    ],
    includes = ["shared_memory"],
    include_prefix = "open_auto_transport",
    linkopts = ["-pthread"],
    visibility = ["//visibility:public"],
    deps = [
        ":wire_capnp",
        "@boost.asio",
        "@boost.interprocess",
        "@capnp-cpp//src/capnp:capnp",
        "@capnp-cpp//src/kj:kj",
    ],
)

cc_binary(
    name = "open_auto_transport_demo",
    srcs = ["transport_demo.cpp"],
    deps = [
        ":open_auto_transport",
    ],
)
