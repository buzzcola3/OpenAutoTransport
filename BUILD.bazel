genrule(
    name = "wire_capnp_gen",
    srcs = ["wire.capnp"],
    outs = [
        "wire.capnp.h",
        "wire.capnp.c++",
    ],
        tools = [
                "@capnp-cpp//src/capnp:capnp_tool",
                "@capnp-cpp//src/capnp:capnpc-c++",
        ],
        cmd = """
            set -euo pipefail
            SRC="$(location :wire.capnp)"
            SRCDIR="$$(dirname "$$SRC")"
            OUTDIR="$(@D)"
            CAPNP_BIN="$(execpath @capnp-cpp//src/capnp:capnp_tool)"
            CAPNPC_PLUGIN="$(execpath @capnp-cpp//src/capnp:capnpc-c++)"
            mkdir -p "$$OUTDIR"
            "$$CAPNP_BIN" compile \
                -I "$$SRCDIR" \
                -o"$$CAPNPC_PLUGIN":"$$OUTDIR" \
                "$$SRC"
        """,
    visibility = ["//visibility:public"],
)

cc_library(
    name = "wire_capnp",
    srcs = ["wire.capnp.c++"],
    hdrs = ["wire.capnp.h"],
    copts = ["-xc++"],
    deps = [
        ":wire_capnp_gen",
        "@capnp-cpp//src/capnp:capnp",
        "@capnp-cpp//src/kj:kj",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "open_auto_transport",
    srcs = ["transport.cpp"],
    hdrs = ["transport.hpp", "wire.hpp"],
    copts = ["-fPIC", "-Ishared_memory"],
    deps = [
        ":wire_capnp",
        "//shared_memory:duplex_shm_transport",
        "@boost.asio",
        "@capnp-cpp//src/capnp:capnp",
        "@capnp-cpp//src/kj:kj",
    ],
    visibility = ["//visibility:public"],
)

cc_binary(
    name = "open_auto_transport_demo",
    srcs = ["transport_demo.cpp"],
    copts = ["-Ishared_memory"],
    deps = [
        ":open_auto_transport",
        ":wire_capnp",
        "//shared_memory:duplex_shm_transport",
        "@capnp-cpp//src/capnp:capnp",
        "@capnp-cpp//src/kj:kj",
        "@boost.asio",
    ],
)