genrule(
    name = "wire_capnp_gen",
    srcs = ["wire.capnp"],
    outs = [
        "wire.capnp.h",
        "wire.capnp.c++",
    ],
    cmd = """
            set -euo pipefail
            SRC="$(location :wire.capnp)"
            SRCDIR="$$(dirname "$$SRC")"
            OUTDIR="$(@D)"
            TMPDIR="$$OUTDIR/.capnp_tmp"
            CAPNP_BIN="$(execpath @capnp-cpp//src/capnp:capnp_tool)"
            CAPNPC_PLUGIN="$(execpath @capnp-cpp//src/capnp:capnpc-c++)"
            rm -rf "$$TMPDIR"
            mkdir -p "$$TMPDIR" "$$OUTDIR"
            "$$CAPNP_BIN" compile \
                -I "$$SRCDIR" \
                -o"$$CAPNPC_PLUGIN":"$$TMPDIR" \
                "$$SRC"
            # Copy to the exact declared output file paths (files, not directories)
            cp "$$TMPDIR"/wire.capnp.h "$$OUTDIR"/wire.capnp.h
            cp "$$TMPDIR"/wire.capnp.c++ "$$OUTDIR"/wire.capnp.c++
            # Cleanup temporary directory
            rm -rf "$$TMPDIR"
        """,
    tools = [
        "@capnp-cpp//src/capnp:capnp_tool",
        "@capnp-cpp//src/capnp:capnpc-c++",
    ],
    visibility = ["//visibility:public"],
)

# Public access to the generated files themselves (if a consumer needs raw files)
filegroup(
    name = "wire_capnp_generated",
    srcs = [
        "wire.capnp.h",
        "wire.capnp.c++",
    ],
    visibility = ["//visibility:public"],
)

# Library wrapping the generated Cap'n Proto sources
cc_library(
    name = "wire_capnp",
    srcs = ["wire.capnp.c++"],
    hdrs = ["wire.capnp.h"],
    copts = ["-xc++"],
    deps = [
        "@capnp-cpp//src/capnp:capnp",
        "@capnp-cpp//src/kj:kj",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "open_auto_transport",
    srcs = [
        "transport.cpp",
    ],
    hdrs = [
        "transport.hpp",
        "wire.hpp",
    ],
    copts = [
        "-fPIC",
    ],
    includes = ["shared_memory"],
    visibility = ["//visibility:public"],
    deps = [
        ":wire_capnp",
        "//shared_memory:duplex_shm_transport",
        "@boost.asio",
        "@capnp-cpp//src/capnp:capnp",
        "@capnp-cpp//src/kj:kj",
    ],
)

cc_binary(
    name = "open_auto_transport_demo",
    srcs = ["transport_demo.cpp"],
    deps = [
        ":open_auto_transport",
    ],
)
